# Copy to .env. Never commit that file. No broker variables exist.
DATA_MODE=demo
# Optional absolute SQLAlchemy URL; omitted = project/data/marketlens.db
# DATABASE_URL=sqlite:///C:/path/to/MarketLens/data/marketlens.db
EODHD_API_KEY=
EODHD_REQUESTS_PER_MINUTE=15
# Credits, not HTTP requests. EOD/splits/dividends/FX use ≥1 each.
# A full 14-instrument refresh + FX requires at least 43 credits.
# Keep 20 for sandbox; raise only to a limit covered by your paid plan.
EODHD_DAILY_BUDGET=20
ENABLE_NEWS=false
ENABLE_FUNDAMENTALS=false
HISTORY_YEARS=8
SCHEDULER_ENABLED=false
# Wait after exchange close for vendor EOD publication; verify your plan's availability.
PROVIDER_LAG_MINUTES=180
# Optional initial rules JSON, read ONLY when creating the database's first revision.
# INITIAL_RULES_PATH=C:/path/to/my-rules.json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
