# Copy to .env. Never commit that file. No broker variables exist.
DATA_MODE=yahoo
# No account/API key required for Yahoo daily history or Google News RSS.
YAHOO_REQUEST_INTERVAL_SECONDS=2
DISCOVERY_ENABLED=true
# Maximum per asset type per market. Discovery does not download every history.
DISCOVERY_LIMIT=250
# Maximum new company-profile lookups per stock discovery; cache lifetime 24h.
DISCOVERY_FUNDAMENTAL_BUDGET=20
# Optional quote-only Moomoo OpenD gateway; collection is enabled in US Intraday.
MOOMOO_OPEND_PORT=11111
# Optional absolute SQLAlchemy URL; omitted = project/data/marketlens.db
# DATABASE_URL=sqlite:///C:/path/to/MarketLens/data/marketlens.db
# Optional legacy provider settings, used only with DATA_MODE=eodhd:
EODHD_API_KEY=
EODHD_REQUESTS_PER_MINUTE=15
# Credits, not HTTP requests. EOD/splits/dividends/FX use ≥1 each.
# A full 14-instrument refresh + FX requires at least 43 credits.
# Keep 20 for sandbox; raise only to a limit covered by your paid plan.
EODHD_DAILY_BUDGET=20
ENABLE_NEWS=true
ENABLE_FUNDAMENTALS=false
HISTORY_YEARS=8
SCHEDULER_ENABLED=true
# Opt in only after reviewing the public research fields in docs/HYBRID.md.
# The current owner's local .env enables this explicitly; new installs default off.
PUBLISH_ENABLED=false
PUBLISH_REPOSITORY=mohitkapoor2484-ship-it/marketlens
PUBLISH_BRANCH=research-data
PUBLISH_INTERVAL_MINUTES=5
# Optional; otherwise existing Git Credential Manager sign-in is used.
# PUBLISH_GITHUB_TOKEN=  # repository Contents write only; NEVER a VITE_ variable
# Wait after exchange close for vendor EOD publication; verify your plan's availability.
PROVIDER_LAG_MINUTES=180
# Optional initial rules JSON, read ONLY when creating the database's first revision.
# INITIAL_RULES_PATH=C:/path/to/my-rules.json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
